# Copy to .env and fill in values for your environment.
# Telegram integration (optional but recommended)

TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Optional: Healthchecks.io ping URL
# HEALTHCHECKS_URL=https://hc-ping.com/your-uuid

# Optional: fallback email (used when Telegram fails)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASS=app_password
# FALLBACK_EMAIL=you@gmail.com

# Optional: screener preset (default | strict | loose)
# SCREENER_PRESET=default
